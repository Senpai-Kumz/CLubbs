# Local development configuration only. Copy this file to .env.
# Never commit .env or use the example secret in production.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-development-only-replace-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=https://clubbs.onrender.com
DJANGO_SECURE_SSL_REDIRECT=False

# Leave DATABASE_URL blank for local SQLite.
# Production must use a managed PostgreSQL connection URL.
DATABASE_URL=

# Optional: configure Redis for shared real-time messaging.
REDIS_URL=

# Cloudinary media storage (required for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
